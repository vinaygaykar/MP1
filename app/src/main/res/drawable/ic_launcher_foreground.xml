<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1000"
    android:viewportHeight="1000">

    <!-- MASTER SCALE GROUP: Pre-scaled to 72% (720x720) for Adaptive Icon safe zone -->
    <group
        android:name="cd_master"
        android:pivotX="500"
        android:pivotY="500"
        android:scaleX="0.72"
        android:scaleY="0.72">

        <!-- ================================================================= -->
        <!-- GROUP 1: IRIDESCENT RAINBOW LAYER                                 -->
        <!-- ================================================================= -->
        <group
            android:name="iridescent_rainbow"
            android:pivotX="500"
            android:pivotY="500"
            android:rotation="0">

            <!-- 1A. Smooth 360-Degree Sweep Gradient (Data Area: r=142 to r=448) -->
            <path
                android:fillType="evenOdd"
                android:pathData="M500,52 A448,448 0 1,0 500,948 A448,448 0 1,0 500,52 Z M500,358 A142,142 0 1,1 500,642 A142,142 0 1,1 500,358 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:centerX="500"
                        android:centerY="500"
                        android:type="sweep">
                        <item android:color="#FF9A9DA6" android:offset="0.00" />
                        <item android:color="#FFF582D7" android:offset="0.06" />
                        <item android:color="#FFD9F970" android:offset="0.11" />
                        <item android:color="#FF56D8FF" android:offset="0.15" />
                        <item android:color="#FFFF3EB5" android:offset="0.20" />
                        <item android:color="#FFF4CBB8" android:offset="0.25" />
                        <item android:color="#FF52E5E7" android:offset="0.29" />
                        <item android:color="#FFB8B5CF" android:offset="0.33" />
                        <item android:color="#FF7CF768" android:offset="0.37" />
                        <item android:color="#FFFF8563" android:offset="0.41" />
                        <item android:color="#FF9699A1" android:offset="0.48" />
                        <item android:color="#FF9699A1" android:offset="0.52" />
                        <item android:color="#FFF28CE2" android:offset="0.56" />
                        <item android:color="#FF5CB3FF" android:offset="0.61" />
                        <item android:color="#FFFF3BE2" android:offset="0.66" />
                        <item android:color="#FFFF94D6" android:offset="0.71" />
                        <item android:color="#FFF5D5C8" android:offset="0.76" />
                        <item android:color="#FFCED4E2" android:offset="0.82" />
                        <item android:color="#FF5CE8E6" android:offset="0.86" />
                        <item android:color="#FF98F56C" android:offset="0.89" />
                        <item android:color="#FFF7B267" android:offset="0.94" />
                        <item android:color="#FF9A9DA6" android:offset="1.00" />
                    </gradient>
                </aapt:attr>
            </path>

        </group>

        <!-- ================================================================= -->
        <!-- GROUP 2: HYBRID CLEAR POLYCARBONATE HUB (r=61.5 to r=142)         -->
        <!-- ================================================================= -->
        <group
            android:name="hub_plastic_glare"
            android:pivotX="500"
            android:pivotY="500"
            android:rotation="0">

            <!-- 2A. Inner Flat Clamping Area (r=61.5 to r=131): 14% Opacity Cool White Tint -->
            <path
                android:fillColor="#24F0F6FF"
                android:fillType="evenOdd"
                android:pathData="M500,369 A131,131 0 1,0 500,631 A131,131 0 1,0 500,369 Z M500,438.5 A61.5,61.5 0 1,1 500,561.5 A61.5,61.5 0 1,1 500,438.5 Z" />

            <!-- 2B. Outer Stacking Ring Ridge (r=131 to r=142): 26% Opacity Denser Plastic -->
            <path
                android:fillColor="#42FFFFFF"
                android:fillType="evenOdd"
                android:pathData="M500,358 A142,142 0 1,0 500,642 A142,142 0 1,0 500,358 Z M500,369 A131,131 0 1,1 500,631 A131,131 0 1,1 500,369 Z" />

            <!-- 2C. Smooth Sweep Specular Glare on Clear Plastic (11 o'clock & 5 o'clock) -->
            <path
                android:fillType="evenOdd"
                android:pathData="M500,358 A142,142 0 1,0 500,642 A142,142 0 1,0 500,358 Z M500,438.5 A61.5,61.5 0 1,1 500,561.5 A61.5,61.5 0 1,1 500,438.5 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:centerX="500"
                        android:centerY="500"
                        android:type="sweep">
                        <item android:color="#05FFFFFF" android:offset="0.00" />
                        <item android:color="#05FFFFFF" android:offset="0.10" />
                        <item android:color="#47FFFFFF" android:offset="0.18" />
                        <item android:color="#05FFFFFF" android:offset="0.26" />
                        <item android:color="#05FFFFFF" android:offset="0.58" />
                        <item android:color="#59FFFFFF" android:offset="0.67" />
                        <item android:color="#05FFFFFF" android:offset="0.76" />
                        <item android:color="#05FFFFFF" android:offset="1.00" />
                    </gradient>
                </aapt:attr>
            </path>
        </group>

        <!-- ================================================================= -->
        <!-- GROUP 3: INNER CONCENTRIC BLACK LINEWORK (Outer r=448 removed)    -->
        <!-- ================================================================= -->
        <group
            android:name="cd_linework"
            android:pivotX="500"
            android:pivotY="500">

            <!-- Clamping Ring Double-Line Boundary (r=142 & r=131) -->
            <path
                android:fillColor="#00000000"
                android:pathData="M500,358 A142,142 0 1,0 500,642 A142,142 0 1,0 500,358 Z"
                android:strokeWidth="3.2"
                android:strokeColor="#FF111111" />
            <path
                android:fillColor="#00000000"
                android:pathData="M500,369 A131,131 0 1,0 500,631 A131,131 0 1,0 500,369 Z"
                android:strokeWidth="2.8"
                android:strokeColor="#FF111111" />

            <!-- Center Spindle Hole Black Outline (r=61.5) -->
            <path
                android:fillColor="#00000000"
                android:pathData="M500,438.5 A61.5,61.5 0 1,0 500,561.5 A61.5,61.5 0 1,0 500,438.5 Z"
                android:strokeWidth="3.2"
                android:strokeColor="#FF111111" />
        </group>

    </group>
</vector>