<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1000"
    android:viewportHeight="1000">

    <!-- MASTER SCALE GROUP: Pre-scaled to 72% (720x720) so it fits safely inside Android's Adaptive Icon circle -->
    <!-- Change scaleX/scaleY to 1.0 if using full-bleed inside an ImageView -->
    <group
        android:name="cd_master"
        android:pivotX="500"
        android:pivotY="500"
        android:scaleX="0.72"
        android:scaleY="0.72">

        <!-- ================================================================= -->
        <!-- GROUP 1: IRIDESCENT RAINBOW LAYER (Animate rotation for shimmer!) -->
        <!-- ================================================================= -->
        <group
            android:name="iridescent_rainbow"
            android:pivotX="500"
            android:pivotY="500"
            android:rotation="0">

            <!-- 1A. Smooth 360-Degree Sweep Gradient (Data Area: r=142 to r=448) -->
            <path
                android:fillType="evenOdd"
                android:pathData="M500,52 A448,448 0 1,0 500,948 A448,448 0 1,0 500,52 Z M500,358 A142,142 0 1,1 500,642 A142,142 0 1,1 500,358 Z">
                <aapt:attr name="android:fillColor">
                    <!-- Sweep starts at 0° (3 o'clock) and wraps clockwise -->
                    <gradient
                        android:centerX="500"
                        android:centerY="500"
                        android:type="sweep">
                        <!-- 0° (3 o'clock): Brushed Metallic Silver-Grey -->
                        <item
                            android:color="#FF9A9DA6"
                            android:offset="0.00" />
                        <!-- 22° (4 o'clock): Pastel Lilac / Pink -->
                        <item
                            android:color="#FFF582D7"
                            android:offset="0.06" />
                        <!-- 40° (4:30): Soft Yellow / Mint -->
                        <item
                            android:color="#FFD9F970"
                            android:offset="0.11" />
                        <!-- 54° (5 o'clock): Bright Cyan / Sky Blue -->
                        <item
                            android:color="#FF56D8FF"
                            android:offset="0.15" />
                        <!-- 72° (5:30): Vivid Magenta / Hot Pink -->
                        <item
                            android:color="#FFFF3EB5"
                            android:offset="0.20" />
                        <!-- 90° (6 o'clock): Warm Peach / Cream -->
                        <item
                            android:color="#FFF4CBB8"
                            android:offset="0.25" />
                        <!-- 105° (6:30): Turquoise / Aqua -->
                        <item
                            android:color="#FF52E5E7"
                            android:offset="0.29" />
                        <!-- 120° (7 o'clock): Silver / Lavender -->
                        <item
                            android:color="#FFB8B5CF"
                            android:offset="0.33" />
                        <!-- 133° (7:30): Neon Green / Lime -->
                        <item
                            android:color="#FF7CF768"
                            android:offset="0.37" />
                        <!-- 148° (8 o'clock): Warm Coral / Orange -->
                        <item
                            android:color="#FFFF8563"
                            android:offset="0.41" />
                        <!-- 175° (9 o'clock): Brushed Metallic Silver-Grey -->
                        <item
                            android:color="#FF9699A1"
                            android:offset="0.48" />
                        <item
                            android:color="#FF9699A1"
                            android:offset="0.52" />
                        <!-- 200° (9:30): Pink / Orchid -->
                        <item
                            android:color="#FFF28CE2"
                            android:offset="0.56" />
                        <!-- 218° (10 o'clock): Electric Blue / Cyan -->
                        <item
                            android:color="#FF5CB3FF"
                            android:offset="0.61" />
                        <!-- 238° (11 o'clock): Vivid Magenta / Violet -->
                        <item
                            android:color="#FFFF3BE2"
                            android:offset="0.66" />
                        <!-- 256° (11:30): Soft Rose / Pink -->
                        <item
                            android:color="#FFFF94D6"
                            android:offset="0.71" />
                        <!-- 275° (12 o'clock): Soft Peach / Warm White -->
                        <item
                            android:color="#FFF5D5C8"
                            android:offset="0.76" />
                        <!-- 295° (1 o'clock): Pale Lavender / Silver -->
                        <item
                            android:color="#FFCED4E2"
                            android:offset="0.82" />
                        <!-- 310° (1:30): Bright Aqua / Cyan -->
                        <item
                            android:color="#FF5CE8E6"
                            android:offset="0.86" />
                        <!-- 322° (2 o'clock): Lime / Yellow-Green -->
                        <item
                            android:color="#FF98F56C"
                            android:offset="0.89" />
                        <!-- 338° (2:30): Golden Amber / Peach -->
                        <item
                            android:color="#FFF7B267"
                            android:offset="0.94" />
                        <!-- 360° (3 o'clock): Back to Brushed Metallic Silver-Grey -->
                        <item
                            android:color="#FF9A9DA6"
                            android:offset="1.00" />
                    </gradient>
                </aapt:attr>
            </path>

            <!-- 1B. Radial Metallic Depth & 3D Surface Luster Overlay -->
            <path
                android:fillType="evenOdd"
                android:pathData="M500,52 A448,448 0 1,0 500,948 A448,448 0 1,0 500,52 Z M500,358 A142,142 0 1,1 500,642 A142,142 0 1,1 500,358 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:centerX="500"
                        android:centerY="500"
                        android:gradientRadius="448"
                        android:type="radial">
                        <item
                            android:color="#47FFFFFF"
                            android:offset="0.00" />
                        <item
                            android:color="#00FFFFFF"
                            android:offset="0.35" />
                        <item
                            android:color="#26D0D5DD"
                            android:offset="0.70" />
                        <item
                            android:color="#38FFFFFF"
                            android:offset="0.92" />
                        <item
                            android:color="#599CA3AF"
                            android:offset="1.00" />
                    </gradient>
                </aapt:attr>
            </path>
        </group>

        <!-- ================================================================= -->
        <!-- GROUP 2: HYBRID CLEAR POLYCARBONATE HUB (r=61.5 to r=142)         -->
        <!-- ================================================================= -->
        <group
            android:name="hub_plastic_glare"
            android:pivotX="500"
            android:pivotY="500"
            android:rotation="0">

            <!-- 2A. Inner Flat Clamping Area (r=61.5 to r=131): 14% Opacity Cool White Tint -->
            <path
                android:fillColor="#24F0F6FF"
                android:fillType="evenOdd"
                android:pathData="M500,369 A131,131 0 1,0 500,631 A131,131 0 1,0 500,369 Z M500,438.5 A61.5,61.5 0 1,1 500,561.5 A61.5,61.5 0 1,1 500,438.5 Z" />

            <!-- 2B. Outer Stacking Ring Ridge (r=131 to r=142): 26% Opacity Denser Plastic -->
            <path
                android:fillColor="#42FFFFFF"
                android:fillType="evenOdd"
                android:pathData="M500,358 A142,142 0 1,0 500,642 A142,142 0 1,0 500,358 Z M500,369 A131,131 0 1,1 500,631 A131,131 0 1,1 500,369 Z" />

            <!-- 2C. Smooth Sweep Specular Glare on Clear Plastic (11 o'clock & 5 o'clock) -->
            <path
                android:fillType="evenOdd"
                android:pathData="M500,358 A142,142 0 1,0 500,642 A142,142 0 1,0 500,358 Z M500,438.5 A61.5,61.5 0 1,1 500,561.5 A61.5,61.5 0 1,1 500,438.5 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:centerX="500"
                        android:centerY="500"
                        android:type="sweep">
                        <item
                            android:color="#05FFFFFF"
                            android:offset="0.00" />
                        <!-- 5 o'clock Counter Glare -->
                        <item
                            android:color="#05FFFFFF"
                            android:offset="0.10" />
                        <item
                            android:color="#47FFFFFF"
                            android:offset="0.18" />
                        <item
                            android:color="#05FFFFFF"
                            android:offset="0.26" />
                        <!-- Clear side -->
                        <item
                            android:color="#05FFFFFF"
                            android:offset="0.58" />
                        <!-- 11 o'clock Primary Glare -->
                        <item
                            android:color="#59FFFFFF"
                            android:offset="0.67" />
                        <item
                            android:color="#05FFFFFF"
                            android:offset="0.76" />
                        <item
                            android:color="#05FFFFFF"
                            android:offset="1.00" />
                    </gradient>
                </aapt:attr>
            </path>
        </group>

        <!-- ================================================================= -->
        <!-- GROUP 3: CONCENTRIC BLACK LINEWORK                                -->
        <!-- ================================================================= -->
        <group
            android:name="cd_linework"
            android:pivotX="500"
            android:pivotY="500">

            <!-- 1. Outermost Black Perimeter Edge (r=448) -->
            <path
                android:fillColor="#00000000"
                android:pathData="M500,52 A448,448 0 1,0 500,948 A448,448 0 1,0 500,52 Z"
                android:strokeWidth="4"
                android:strokeColor="#FF111111" />

            <!-- 2. Just-Inside Outer Rim Line (r=434) -->
            <path
                android:fillColor="#00000000"
                android:pathData="M500,66 A434,434 0 1,0 500,934 A434,434 0 1,0 500,66 Z"
                android:strokeWidth="3"
                android:strokeColor="#FF111111" />

            <!-- 3. Outer Hub / Mirror Band Ring (r=168) -->
            <path
                android:fillColor="#00000000"
                android:pathData="M500,332 A168,168 0 1,0 500,668 A168,168 0 1,0 500,332 Z"
                android:strokeWidth="3.2"
                android:strokeColor="#FF111111" />

            <!-- 4. Clamping Ring Double-Line Boundary (r=142 & r=131) -->
            <path
                android:fillColor="#00000000"
                android:pathData="M500,358 A142,142 0 1,0 500,642 A142,142 0 1,0 500,358 Z"
                android:strokeWidth="3.2"
                android:strokeColor="#FF111111" />
            <path
                android:fillColor="#00000000"
                android:pathData="M500,369 A131,131 0 1,0 500,631 A131,131 0 1,0 500,369 Z"
                android:strokeWidth="2.8"
                android:strokeColor="#FF111111" />

            <!-- 5. Center Spindle Hole Black Outline (r=61.5) -->
            <path
                android:fillColor="#00000000"
                android:pathData="M500,438.5 A61.5,61.5 0 1,0 500,561.5 A61.5,61.5 0 1,0 500,438.5 Z"
                android:strokeWidth="3.2"
                android:strokeColor="#FF111111" />
        </group>

    </group>
</vector>
